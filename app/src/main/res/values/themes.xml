<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Tutu" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.Tutu.Splash" parent="Theme.SplashScreen">
        <!-- android:windowBackground is redundant with windowSplashScreenBackground below,
             but some OEM skins (MIUI) paint the very first frame from windowBackground
             instead of the splash-screen attribute, showing black otherwise. -->
        <item name="android:windowBackground">#3D75E0</item>
        <item name="windowSplashScreenBackground">#3D75E0</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.Tutu</item>
    </style>
</resources>